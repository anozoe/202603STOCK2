package com.example.STOCK;

import java.math.BigDecimal;

import com.example.stock.batch.dto.ExecutionInfoResponse;
import com.example.stock.batch.service.ExecutionCheckService;
import com.example.stock.constants.ORDER_SIDE;

public class ExecutionCheckTrial {
    
    public static void main(String[] args) {
        // ExecutionInfoService は null で OK
        // （buyExecutionCheck は this.executionInfoService を使わないので）
        ExecutionCheckService service = new ExecutionCheckService(null);

        // ----- ケース 1: 約定する（現値 < 指値）-----
        System.out.println("=== ケース1: 現値 < 指値 → 約定する ===");
        ExecutionInfoResponse case1 = newOrder();
        case1.setCurrentPrice(new BigDecimal("100.00"));
        case1.setLimitPrice(new BigDecimal("150.00"));
        case1.setOrderQuantity(10);
        service.buyExecutionCheck(case1);
        print(case1);

        // ----- ケース 2: 約定する（現値 = 指値、境界値）-----
        System.out.println("\n=== ケース2: 現値 = 指値 → 約定する ===");
        ExecutionInfoResponse case2 = newOrder();
        case2.setCurrentPrice(new BigDecimal("100.00"));
        case2.setLimitPrice(new BigDecimal("100.00"));
        case2.setOrderQuantity(5);
        service.buyExecutionCheck(case2);
        print(case2);

        // ----- ケース 3: 約定しない（現値 > 指値）-----
        System.out.println("\n=== ケース3: 現値 > 指値 → 約定しない ===");
        ExecutionInfoResponse case3 = newOrder();
        case3.setCurrentPrice(new BigDecimal("200.00"));
        case3.setLimitPrice(new BigDecimal("150.00"));
        case3.setOrderQuantity(10);
        service.buyExecutionCheck(case3);
        print(case3);

        // ----- ケース 4: 割り切れない比率計算（ゼロ除算/精度問題の検証）-----
        System.out.println("\n=== ケース4: 割り切れない比率計算 ===");
        ExecutionInfoResponse case4 = newOrder();
        case4.setCurrentPrice(new BigDecimal("33.33"));
        case4.setLimitPrice(new BigDecimal("100.00"));
        case4.setOrderQuantity(3);
        case4.setHoldingsValue(new BigDecimal("300.00"));
        case4.setUnrealizedPnl(new BigDecimal("100.00"));
        service.buyExecutionCheck(case4);
        print(case4);
    }

    /** 共通の初期値を持つ注文を作るヘルパー */
    private static ExecutionInfoResponse newOrder() {
        ExecutionInfoResponse r = new ExecutionInfoResponse();
        r.setOrderSide(ORDER_SIDE.BUY.getCode());
        // assets 系は NOT NULL なので 0 で埋めておく
        r.setBuyingPower(new BigDecimal("1000000.00"));
        r.setHoldingsValue(BigDecimal.ZERO);
        r.setTotalAssets(new BigDecimal("1000000.00"));
        r.setUnrealizedPnl(BigDecimal.ZERO);
        r.setUnrealizedPnlRatio(BigDecimal.ZERO);
        return r;
    }

    /** 結果を見やすく出力 */
    private static void print(ExecutionInfoResponse r) {
        System.out.println("  orderExecutionStatus = " + r.getOrderExecutionStatus());
        System.out.println("  executedPrice        = " + r.getExecutedPrice());
        System.out.println("  averagePrice         = " + r.getAveragePrice());
        System.out.println("  profitLoss           = " + r.getProfitLoss());
        System.out.println("  profitLossRatio      = " + r.getProfitLossRatio());
        System.out.println("  marketValue          = " + r.getMarketValue());
        System.out.println("  holdingAmount        = " + r.getHoldingAmount());
        System.out.println("  buyingPower          = " + r.getBuyingPower());
        System.out.println("  holdingsValue        = " + r.getHoldingsValue());
        System.out.println("  totalAssets          = " + r.getTotalAssets());
        System.out.println("  unrealizedPnl        = " + r.getUnrealizedPnl());
        System.out.println("  unrealizedPnlRatio   = " + r.getUnrealizedPnlRatio());
    }
}